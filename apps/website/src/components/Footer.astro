---
import FieldLedgerLogo from './FieldLedgerLogo.astro';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-carbon-800 bg-carbon-950 py-14 text-slate-400">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="space-y-4">
        <FieldLedgerLogo size={32} />
        <p class="text-xs leading-relaxed">Structured field records for fire extinguisher, kitchen exhaust cleaning, and grease trap service businesses.</p>
        <span class="inline-flex items-center gap-2 rounded-lg border border-safety-orange/30 bg-safety-orange/10 px-2.5 py-1 text-xs font-semibold text-safety-orange">
          <span class="h-1.5 w-1.5 rounded-full bg-safety-orange"></span>
          Offline-capable field PWA
        </span>
      </div>
      <div>
        <h2 class="mb-4 text-xs font-bold uppercase tracking-wider text-slate-200">Solutions</h2>
        <ul class="space-y-2 text-xs">
          <li><a href="/hood-cleaning" class="transition-colors hover:text-safety-amber">Hood cleaning records</a></li>
          <li><a href="/fire-extinguisher" class="transition-colors hover:text-safety-orange">Fire extinguisher service</a></li>
          <li><a href="/grease-trap" class="transition-colors hover:text-safety-cyan">Grease trap service</a></li>
          <li><a href="/#pricing" class="transition-colors hover:text-white">Pricing</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mb-4 text-xs font-bold uppercase tracking-wider text-slate-200">Security & Legal</h2>
        <ul class="space-y-2 text-xs">
          <li><a href="/security" class="transition-colors hover:text-emerald-400">Security Architecture</a></li>
          <li><a href="/compliance" class="transition-colors hover:text-cyan-400">Trade Code Compliance</a></li>
          <li><a href="/privacy" class="transition-colors hover:text-white">Privacy Policy</a></li>
          <li><a href="/terms" class="transition-colors hover:text-white">Terms of Service</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mb-4 text-xs font-bold uppercase tracking-wider text-slate-200">Product Boundary</h2>
        <p class="text-xs leading-relaxed text-slate-500">FieldLedger records operator-entered work and observations. It does not independently certify legal or regulatory compliance. Contractors remain responsible for applicable requirements and professional judgment.</p>
      </div>
    </div>
    <div class="mt-12 flex flex-col justify-between gap-4 border-t border-carbon-800 pt-6 text-xs sm:flex-row">
      <p>© {currentYear} FieldLedger. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/#how-it-works" class="hover:text-white">How it works</a>
        <a href="/#faq" class="hover:text-white">FAQ</a>
        <a href="/privacy" class="hover:text-white">Privacy</a>
        <a href="/terms" class="hover:text-white">Terms</a>
        <a href="/security" class="hover:text-white">Security</a>
      </div>
    </div>
  </div>
</footer>
