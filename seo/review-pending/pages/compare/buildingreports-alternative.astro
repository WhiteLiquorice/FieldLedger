---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const title = "The #1 Flat-Rate Alternative to BuildingReports (2026) | FieldLedger";
const description = "Stop paying 20¢ to 50¢ per barcode scan. See why commercial fire contractors are switching from BuildingReports to FieldLedger's $49/mo flat-rate inspection software.";
const canonical = "https://fieldledger.bridgewayapps.com/compare/buildingreports-alternative";

const comparisonTable = [
  { feature: 'Monthly Subscription', buildingReports: '$200 - $800+ / mo', fieldLedger: '$49 / mo (Starter, up to 3 techs)' },
  { feature: 'Per-Barcode Scan Fees', buildingReports: '20¢ to 50¢ PER SCAN', fieldLedger: '0¢ (UNLIMITED SCANS INCLUDED)' },
  { feature: 'Hardware Requirements', buildingReports: 'Specialized scanners or proprietary hardware', fieldLedger: 'Any iPhone, Android, or tablet' },
  { feature: 'Offline Basement PWA Mode', buildingReports: 'Limited / Requires network sync', fieldLedger: '100% Offline IndexedDB Cache' },
  { feature: 'Trade Verticals Covered', buildingReports: 'Fire alarm & sprinklers focus', fieldLedger: 'Fire Extinguishers, Kitchen Hoods, Grease Traps' },
  { feature: 'Photo Verification & Proof', buildingReports: 'Add-on module fees', fieldLedger: 'Included with timestamp and GPS' },
  { feature: 'Contract / Lock-In', buildingReports: 'Annual enterprise contracts', fieldLedger: 'Month-to-month, cancel anytime' },
  { feature: 'Free Trial', buildingReports: 'Requires sales demo', fieldLedger: '14-Day Free Trial (Instant launch)' },
];

const faqs = [
  {
    question: 'Why do contractors switch from BuildingReports to FieldLedger?',
    answer: 'The #1 reason is per-barcode scan fees. An active contractor inspecting 2,000 extinguishers a month pays $400 to $1,000+ in scan fees alone on legacy platforms. FieldLedger charges a predictable flat monthly rate ($49/mo) with unlimited scans.'
  },
  {
    question: 'Can I scan existing BuildingReports barcodes with FieldLedger?',
    answer: 'Yes! FieldLedger’s universal camera scanner recognizes all standard 1D and 2D barcodes (Code 128, Code 39, QR code, Data Matrix). You do not need to re-tag existing customer equipment.'
  },
  {
    question: 'Are FieldLedger inspection certificates accepted by local fire marshals?',
    answer: 'Yes. FieldLedger generates official NFPA 10 and NFPA 96 compliant PDF certificates featuring technician license numbers, test dates, GPS verification, and pass/fail checklist items.'
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Navbar />

  <main class="relative z-10 pt-28 pb-20 px-4 sm:px-6 max-w-5xl mx-auto text-left">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href="/compare" class="hover:text-white transition-colors">Comparisons</a>
      <span>/</span>
      <span class="text-orange-400 font-semibold">BuildingReports Alternative</span>
    </nav>

    <!-- Header Hero -->
    <div class="rounded-3xl border border-carbon-700 bg-carbon-900/90 p-8 sm:p-12 backdrop-blur-xl relative overflow-hidden mb-12 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-4 py-1.5 text-xs font-semibold text-orange-400 mb-6">
        <span>💰 Flat-Rate Pricing vs Per-Scan Penalties</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-6">
        The Modern Alternative to BuildingReports
      </h1>

      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed mb-8">
        Why pay 20¢ to 50¢ every time your technician scans a fire extinguisher tag? FieldLedger delivers sub-2 second barcode scans, 100% offline mobile PWA, and instant PDF certificates for a flat <strong class="text-white">$49/month</strong>.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/app?plan=pro"
          class="rounded-xl bg-orange-500 hover:bg-orange-400 text-white font-bold px-8 py-4 text-sm shadow-xl shadow-orange-500/25 transition-all"
        >
          <span>Launch 14-Day Free Trial →</span>
        </a>
      </div>
    </div>

    <!-- Head-to-Head Comparison Table -->
    <div class="rounded-3xl border border-carbon-700 bg-carbon-900/80 p-6 sm:p-8 mb-16 overflow-hidden">
      <h2 class="text-xl sm:text-2xl font-bold text-white mb-6 text-center">
        Side-by-Side Feature & Cost Comparison
      </h2>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-carbon-800 text-slate-400 uppercase text-[11px]">
              <th class="py-3 px-4 font-bold">Feature / Metric</th>
              <th class="py-3 px-4 font-bold text-slate-400">BuildingReports</th>
              <th class="py-3 px-4 font-bold text-orange-400 bg-orange-500/10 rounded-t-xl">FieldLedger</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-carbon-800/60">
            {comparisonTable.map((row) => (
              <tr class="hover:bg-carbon-800/30 transition-colors">
                <td class="py-4 px-4 font-semibold text-white">{row.feature}</td>
                <td class="py-4 px-4 text-slate-400">{row.buildingReports}</td>
                <td class="py-4 px-4 font-bold text-orange-300 bg-orange-500/5">{row.fieldLedger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- 3 Core Advantages -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      <div class="rounded-2xl border border-carbon-700 bg-carbon-900/60 p-6">
        <div class="w-10 h-10 rounded-xl bg-orange-500/10 text-orange-400 border border-orange-500/30 grid place-items-center font-bold text-lg mb-4">
          📱
        </div>
        <h3 class="font-bold text-white text-base mb-2">No Proprietary Scanners</h3>
        <p class="text-xs text-slate-300 leading-relaxed">
          Your techs use their standard smartphone camera. No bulky leased barcode scanners or Bluetooth syncing failures in the field.
        </p>
      </div>

      <div class="rounded-2xl border border-carbon-700 bg-carbon-900/60 p-6">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 grid place-items-center font-bold text-lg mb-4">
          📶
        </div>
        <h3 class="font-bold text-white text-base mb-2">True Offline PWA</h3>
        <p class="text-xs text-slate-300 leading-relaxed">
          Deep boiler rooms and basement parking garages have zero reception. FieldLedger caches everything in IndexedDB and syncs the moment techs step outside.
        </p>
      </div>

      <div class="rounded-2xl border border-carbon-700 bg-carbon-900/60 p-6">
        <div class="w-10 h-10 rounded-xl bg-violet-500/10 text-violet-400 border border-violet-500/30 grid place-items-center font-bold text-lg mb-4">
          🚀
        </div>
        <h3 class="font-bold text-white text-base mb-2">2-Minute Setup</h3>
        <p class="text-xs text-slate-300 leading-relaxed">
          No multi-week onboarding delays or mandatory training seminars. Create an account, invite your technicians, and start scanning routes today.
        </p>
      </div>
    </div>

    <!-- FAQs -->
    <div class="mb-16">
      <h3 class="text-2xl font-bold text-white mb-8">Frequently Asked Questions</h3>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="rounded-2xl border border-carbon-700 bg-carbon-900/60 p-6">
            <h4 class="font-bold text-sm sm:text-base text-white mb-2">{faq.question}</h4>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="rounded-3xl border border-orange-500/30 bg-gradient-to-r from-orange-500/10 via-carbon-900 to-carbon-900 p-8 sm:p-12 text-center">
      <h3 class="text-2xl sm:text-3xl font-black text-white mb-3">
        Ready to Eliminate Per-Scan Fees?
      </h3>
      <p class="text-xs sm:text-sm text-slate-300 max-w-xl mx-auto mb-8">
        Start your 14-day free trial on FieldLedger today. No credit card required.
      </p>
      <a
        href="/app?plan=pro"
        class="inline-flex items-center gap-2 rounded-xl bg-orange-500 hover:bg-orange-400 text-white font-bold px-8 py-4 text-sm shadow-xl shadow-orange-500/30 transition-all"
      >
        <span>Start 14-Day Free Trial →</span>
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
