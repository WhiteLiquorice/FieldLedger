---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const title = "Software Comparisons & Legacy Alternatives | FieldLedger";
const description = "Compare FieldLedger against BuildingReports, InspectPoint, and traditional paper hole-punch inspection tags. See why contractors choose flat-rate $49/mo pricing.";
const canonical = "https://fieldledger.bridgewayapps.com/compare";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Navbar />

  <main class="relative z-10 pt-28 pb-20 px-4 sm:px-6 max-w-5xl mx-auto text-left">
    <div class="rounded-3xl border border-carbon-700 bg-carbon-900/90 p-8 sm:p-12 backdrop-blur-xl relative overflow-hidden mb-12 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-4 py-1.5 text-xs font-semibold text-orange-400 mb-6">
        <span>⚖️ Software & Workflow Comparisons</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-6">
        Compare FieldLedger
      </h1>

      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed mb-8">
        See how FieldLedger's $49/mo flat-rate mobile PWA compares against legacy inspection software and manual paper tagging systems.
      </p>
    </div>

    <!-- Comparison Links Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      <a
        href="/compare/buildingreports-alternative"
        class="group rounded-3xl border border-carbon-700 bg-carbon-900/60 hover:bg-carbon-900 hover:border-orange-500/50 p-8 transition-all shadow-xl flex flex-col justify-between"
      >
        <div>
          <span class="text-xs font-bold text-orange-400 uppercase tracking-widest block mb-4">Flat-Rate Alternative</span>
          <h2 class="text-xl font-bold text-white mb-3 group-hover:text-orange-400 transition-colors">
            vs BuildingReports
          </h2>
          <p class="text-xs text-slate-300 leading-relaxed mb-6">
            Compare $49/mo flat pricing with unlimited scans against 20¢ to 50¢ per-barcode scan fees and proprietary scanner leases.
          </p>
        </div>
        <div class="flex items-center justify-between pt-4 border-t border-carbon-800 text-xs font-bold text-orange-400">
          <span>Read Comparison</span>
          <span>→</span>
        </div>
      </a>

      <a
        href="/compare/inspectpoint-alternative"
        class="group rounded-3xl border border-carbon-700 bg-carbon-900/60 hover:bg-carbon-900 hover:border-orange-500/50 p-8 transition-all shadow-xl flex flex-col justify-between"
      >
        <div>
          <span class="text-xs font-bold text-orange-400 uppercase tracking-widest block mb-4">Modern vs Enterprise</span>
          <h2 class="text-xl font-bold text-white mb-3 group-hover:text-orange-400 transition-colors">
            vs InspectPoint
          </h2>
          <p class="text-xs text-slate-300 leading-relaxed mb-6">
            Compare lightweight mobile PWA simplicity and instant onboarding against heavyweight enterprise systems.
          </p>
        </div>
        <div class="flex items-center justify-between pt-4 border-t border-carbon-800 text-xs font-bold text-orange-400">
          <span>Read Comparison</span>
          <span>→</span>
        </div>
      </a>

      <a
        href="/compare/paper-tags-vs-digital-inspections"
        class="group rounded-3xl border border-carbon-700 bg-carbon-900/60 hover:bg-carbon-900 hover:border-orange-500/50 p-8 transition-all shadow-xl flex flex-col justify-between"
      >
        <div>
          <span class="text-xs font-bold text-orange-400 uppercase tracking-widest block mb-4">Workflow Upgrade</span>
          <h2 class="text-xl font-bold text-white mb-3 group-hover:text-orange-400 transition-colors">
            Paper Tags vs Digital
          </h2>
          <p class="text-xs text-slate-300 leading-relaxed mb-6">
            Discover how switching to digital barcodes eliminates liability risks, satisfies fire marshals, and automates route renewals.
          </p>
        </div>
        <div class="flex items-center justify-between pt-4 border-t border-carbon-800 text-xs font-bold text-orange-400">
          <span>Read Comparison</span>
          <span>→</span>
        </div>
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
