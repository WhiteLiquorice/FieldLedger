---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    author: string;
    authorRole?: string;
    vertical: 'fire-extinguisher' | 'hood-cleaning' | 'grease-trap' | 'general-compliance' | 'comparison';
    tags?: string[];
    canonicalUrl?: string;
    faqs?: Array<{ question: string; answer: string }>;
  };
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { frontmatter, headings = [] } = Astro.props;

const categoryBadges: Record<string, { label: string; color: string }> = {
  'fire-extinguisher': { label: 'Fire Extinguishers', color: 'border-safety-orange/40 bg-safety-orange/10 text-safety-orange' },
  'hood-cleaning': { label: 'Kitchen Hood Cleaning', color: 'border-safety-amber/40 bg-safety-amber/10 text-safety-amber' },
  'grease-trap': { label: 'Grease Traps & FOG', color: 'border-safety-cyan/40 bg-safety-cyan/10 text-safety-cyan' },
  'comparison': { label: 'Software & Tools', color: 'border-purple-500/40 bg-purple-950/40 text-purple-300' },
  'general-compliance': { label: 'Contractor Operations', color: 'border-emerald-500/40 bg-emerald-950/40 text-emerald-400' },
};

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(frontmatter.pubDate);

const breadcrumbs = [
  { name: 'Home', url: 'https://fieldledger.bridgewayapps.com' },
  { name: 'Articles & Guides', url: 'https://fieldledger.bridgewayapps.com/blog' },
  { name: frontmatter.title, url: Astro.url.href }
];

const badge = categoryBadges[frontmatter.vertical] || categoryBadges['general-compliance'];
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  type="article"
  pubDate={frontmatter.pubDate}
  updatedDate={frontmatter.updatedDate}
  author={frontmatter.author}
  faqs={frontmatter.faqs}
  breadcrumbs={breadcrumbs}
>
  <article class="py-12 lg:py-16 bg-carbon-950">
    <!-- Header -->
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6">
        <a href="/" class="hover:text-safety-orange">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-safety-orange">Articles</a>
        <span>/</span>
        <span class="text-slate-300 truncate max-w-xs">{frontmatter.title}</span>
      </nav>

      <!-- Badge & Date -->
      <div class="flex items-center gap-3 mb-4">
        <span class={`inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold ${badge.color}`}>
          {badge.label}
        </span>
        <span class="text-xs text-slate-400">{formattedDate}</span>
      </div>

      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight mb-6 font-sans">
        {frontmatter.title}
      </h1>

      <p class="text-base sm:text-lg text-slate-300 leading-relaxed mb-8 border-l-4 border-safety-orange pl-4 py-2 bg-carbon-900/60 rounded-r-lg border border-carbon-800">
        {frontmatter.description}
      </p>

      <!-- Author Bio bar -->
      <div class="flex items-center justify-between border-y border-carbon-800 py-4 mb-10 text-xs text-slate-400">
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-safety-orange/15 border border-safety-orange/30 text-safety-orange font-bold">
            {frontmatter.author.charAt(0)}
          </div>
          <div>
            <div class="font-bold text-slate-200">{frontmatter.author}</div>
            <div class="text-xs text-slate-400">{frontmatter.authorRole || 'Compliance Specialist'}</div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1 rounded bg-carbon-850 border border-carbon-700 px-2.5 py-1 text-xs text-safety-verified">
            ✓ Code Verified
          </span>
        </div>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Table of Contents -->
      {headings.length > 2 && (
        <div class="mb-10 rounded-2xl border border-carbon-800 bg-carbon-900/70 p-6">
          <div class="text-xs font-bold uppercase tracking-wider text-safety-orange mb-3 flex items-center gap-2">
            <svg class="h-4 w-4 text-safety-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
            </svg>
            In This Guide
          </div>
          <ul class="space-y-2 text-sm text-slate-300">
            {headings.filter(h => h.depth <= 3).map(h => (
              <li class={h.depth === 3 ? 'ml-4 text-xs text-slate-400' : ''}>
                <a href={`#${h.slug}`} class="hover:text-safety-orange transition-colors flex items-baseline gap-1.5">
                  <span class="text-safety-orange/70">&bull;</span>
                  <span>{h.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Markdown Prose Content -->
      <div class="prose prose-invert max-w-none prose-headings:font-extrabold prose-headings:tracking-tight prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:border-b prose-h2:border-carbon-800 prose-h2:pb-2 prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3 prose-p:text-slate-300 prose-p:leading-relaxed prose-p:mb-4 prose-ul:my-4 prose-li:text-slate-300 prose-code:text-safety-amber prose-code:bg-carbon-900 prose-code:border prose-code:border-carbon-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-table:w-full prose-table:border prose-table:border-carbon-800 prose-th:bg-carbon-900 prose-th:p-3 prose-th:text-white prose-th:text-xs prose-td:p-3 prose-td:border-t prose-td:border-carbon-800 prose-td:text-xs prose-blockquote:border-l-4 prose-blockquote:border-safety-orange prose-blockquote:bg-carbon-900/60 prose-blockquote:p-4 prose-blockquote:rounded-r-lg prose-blockquote:text-slate-200">
        <slot />
      </div>

      <!-- FAQ Section if available -->
      {frontmatter.faqs && frontmatter.faqs.length > 0 && (
        <div class="mt-16 border-t border-carbon-800 pt-10">
          <div class="inline-flex items-center gap-1.5 rounded bg-safety-orange/10 border border-safety-orange/30 px-2 py-0.5 text-xs font-semibold text-safety-orange mb-2">
            Frequently Asked Questions
          </div>
          <h2 class="text-2xl font-bold tracking-tight text-white mb-6 font-sans">
            Related Compliance Questions
          </h2>
          <div class="space-y-4">
            {frontmatter.faqs.map(faq => (
              <div class="rounded-xl border border-carbon-800 bg-carbon-900/60 p-5">
                <h3 class="text-base font-bold text-white mb-2 font-sans">{faq.question}</h3>
                <p class="text-sm text-slate-300 leading-relaxed font-sans">{faq.answer}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Clean Contractor In-Article CTA Banner -->
      <div class="mt-16 rounded-2xl border border-safety-orange/30 bg-gradient-to-br from-carbon-900 to-carbon-950 p-8 sm:p-10 text-center shadow-xl relative overflow-hidden">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-3 font-sans">
          Ready to Simplify Your Field Inspections?
        </h3>
        <p class="text-sm text-slate-300 max-w-xl mx-auto mb-8 leading-relaxed font-sans">
          Equip your technicians with fast barcode scanning, automated deficiency alerts, before/after photo documentation, and instant client certificates—all in one simple offline app.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/#pricing" class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-safety-orange to-safety-flame px-8 py-3.5 text-sm font-bold text-slate-950 hover:brightness-110 shadow-lg shadow-safety-orange/20 transition-all hover:scale-[1.02]">
            Start 14-Day Free Trial
          </a>
          <a href="/#how-it-works" class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl border border-carbon-700 bg-carbon-850 px-6 py-3.5 text-sm font-semibold text-slate-200 hover:border-safety-orange/50 hover:text-white transition-all">
            See How It Works
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
