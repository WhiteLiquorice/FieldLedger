---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { GreaseTrapFogCalculator } from '../../components/tools/GreaseTrapFogCalculator';

const title = "25% FOG Rule Grease Trap Sizing & Pumping Calculator | FieldLedger";
const description = "Free interactive calculator for EPA and municipal 25% FOG (Fats, Oils, and Grease) rule compliance. Measure grease and sludge levels to avoid sewer fines.";
const canonical = "https://fieldledger.bridgewayapps.com/tools/grease-trap-fog-calculator";

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '25% FOG Rule Grease Trap Calculator',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Navbar />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="relative z-10 pt-28 pb-20 px-4 sm:px-6 max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href="/tools" class="hover:text-white transition-colors">Tools</a>
      <span>/</span>
      <span class="text-cyan-400 font-semibold">25% Grease Trap Calculator</span>
    </nav>

    <!-- Calculator Component -->
    <GreaseTrapFogCalculator client:load />

    <!-- Educational Context Section for SEO/GEO -->
    <div class="mt-16 rounded-3xl border border-carbon-700 bg-carbon-900/60 p-8 sm:p-10 space-y-6 text-left">
      <h3 class="text-2xl font-bold text-white">Understanding the EPA 25% FOG Rule</h3>
      <div class="space-y-4 text-xs sm:text-sm text-slate-300 leading-relaxed">
        <p>
          Municipal environmental divisions and publicly owned treatment works (POTWs) strictly enforce the <strong>25% Rule</strong> to prevent sewer line blockages and sanitary sewer overflows (SSOs):
        </p>
        <div class="p-4 rounded-xl bg-carbon-950 border border-carbon-800 my-4">
          <p class="font-mono text-cyan-400 font-semibold text-xs mb-2">
            Formula: % Capacity = ((Top Grease Thickness + Bottom Sludge Thickness) / Total Liquid Depth) × 100
          </p>
          <p class="text-slate-400 text-xs">
            When total FOG plus solids reaches 25% of total liquid depth, the grease interceptor loses hydraulic retention time and allows fats to escape directly into municipal sewer lines.
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
