---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { CITIES_DATA, TRADES_CONFIG } from '../../data/cityGeoData';

const title = "Local Contractor Inspection & Compliance Directory | FieldLedger";
const description = "Find city-specific inspection software and local AHJ compliance requirements for fire extinguisher, commercial kitchen hood, and grease trap service contractors.";
const canonical = "https://fieldledger.bridgewayapps.com/geo";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Navbar />

  <main class="relative z-10 pt-28 pb-20 px-4 sm:px-6 max-w-6xl mx-auto text-left">
    <div class="rounded-3xl border border-carbon-700 bg-carbon-900/90 p-8 sm:p-12 backdrop-blur-xl relative overflow-hidden mb-12 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-4 py-1.5 text-xs font-semibold text-orange-400 mb-6">
        <span>📍 Municipal & Regional Directory</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-6">
        Local Contractor Compliance Hubs
      </h1>

      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed mb-8">
        Select your city and trade vertical below to view localized AHJ regulations, municipal sewer FOG codes, and field inspection templates.
      </p>
    </div>

    <!-- City List with Trade Links -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
      {CITIES_DATA.map((city) => (
        <div class="rounded-3xl border border-carbon-700 bg-carbon-900/60 p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-2xl font-bold text-white">📍 {city.name}, {city.stateAbbr}</h2>
              <span class="text-xs font-semibold text-orange-400 bg-orange-500/10 px-2.5 py-1 rounded-full border border-orange-500/20">
                {city.stateName}
              </span>
            </div>
            <p class="text-xs text-slate-400 mb-6">
              Primary Fire AHJ: {city.fireDept}
            </p>

            <div class="space-y-2.5">
              <a
                href={`/geo/${city.slug}/fire-extinguisher`}
                class="flex items-center justify-between p-3 rounded-xl bg-carbon-950 hover:bg-carbon-800 border border-carbon-800 hover:border-orange-500/40 text-xs text-slate-200 transition-all group"
              >
                <span class="font-semibold flex items-center gap-2">
                  <span>🧯</span>
                  <span>Fire Extinguisher Inspection Software</span>
                </span>
                <span class="text-orange-400 group-hover:translate-x-1 transition-transform">→</span>
              </a>

              <a
                href={`/geo/${city.slug}/hood-cleaning`}
                class="flex items-center justify-between p-3 rounded-xl bg-carbon-950 hover:bg-carbon-800 border border-carbon-800 hover:border-violet-500/40 text-xs text-slate-200 transition-all group"
              >
                <span class="font-semibold flex items-center gap-2">
                  <span>💨</span>
                  <span>Kitchen Hood Exhaust Cleaning Software</span>
                </span>
                <span class="text-violet-400 group-hover:translate-x-1 transition-transform">→</span>
              </a>

              <a
                href={`/geo/${city.slug}/grease-trap`}
                class="flex items-center justify-between p-3 rounded-xl bg-carbon-950 hover:bg-carbon-800 border border-carbon-800 hover:border-cyan-500/40 text-xs text-slate-200 transition-all group"
              >
                <span class="font-semibold flex items-center gap-2">
                  <span>🛢️</span>
                  <span>Grease Trap & Interceptor Manifest App</span>
                </span>
                <span class="text-cyan-400 group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </main>

  <Footer />
</BaseLayout>
