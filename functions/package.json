{
  "name": "compliance-saas-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions v2 for FieldLedger recurring service operations",
  "main": "lib/deployment.cjs",
  "scripts": {
    "gcp-build": "",
    "build": "tsc && node build.mjs",
    "test": "npm run build && node --test tests/**/*.test.mjs",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "stripe": "^22.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "esbuild": "0.21.5",
    "typescript": "^5.4.5"
  },
  "private": true
}
